{
  "name": "celiums-memory",
  "version": "2.0.0",
  "private": true,
  "description": "Neuroscience-grounded persistent memory for AI agents — with real emotions, personality, and a simulated brain",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrizoaguimor/celiums-memory.git"
  },
  "homepage": "https://celiums.ai",
  "bugs": {
    "url": "https://github.com/terrizoaguimor/celiums-memory/issues"
  },
  "author": {
    "name": "Celiums Solutions LLC",
    "email": "hello@celiums.ai",
    "url": "https://celiums.ai"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "start": "cargo run --manifest-path rust/Cargo.toml --bin celiums-memory -- mcp",
    "setup": "pnpm install && cargo build --manifest-path rust/Cargo.toml --release -p celiums-memory-cli",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "pnpm --dir apps/cloudflare-worker typecheck && cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings",
    "lint:fix": "pnpm lint",
    "format": "cargo fmt --manifest-path rust/Cargo.toml && prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" \"packages/memory-bench/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" \"packages/plugin-claude-code/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "cargo fmt --manifest-path rust/Cargo.toml -- --check && prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" \"packages/memory-bench/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" \"packages/plugin-claude-code/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "typecheck": "pnpm --dir apps/cloudflare-worker typecheck && pnpm --dir packages/memory-bench typecheck",
    "clean": "turbo run clean",
    "clean:build": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "turbo": "^2.9.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.5.4",
      "fast-uri": ">=3.1.5",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "langsmith": ">=0.6.0",
      "ip-address": ">=10.3.1",
      "form-data": ">=4.0.6",
      "undici": ">=6.27.0",
      "ws": ">=8.21.0",
      "hono": ">=4.12.25",
      "postcss": ">=8.5.18",
      "js-yaml": ">=4.3.0",
      "brace-expansion": ">=5.0.9",
      "vite": ">=7.3.5"
    }
  }
}
